            },
            {
              "type": "Paper",
              "props": {
                "sx": {
                  "p": 2,
                  "mt": 3
                }
              },
              "children": [
                {
                  "type": "Typography",
                  "props": {
                    "variant": "h6",
                    "children": "Monthly Performance",
                    "sx": {
                      "mb": 2
                    }
                  }
