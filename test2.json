                      "props": {
                        "title": "Conversion Rate",
                        "value": "—",
                        "subtitle": "vs last month",
                        "color": "#9c27b0"
                      },
                      "computed": {
                        "value": {
                          "code": "'$' + (ds('ds_kpi_metrics')?.[3]?.value || 0).toFixed(2)"
                        },
                        "change": {
                          "code": "ds('ds_kpi_metrics')?.[3]?.change || 0"
                        },
                        "changeLabel": {
                          "code": "(ds('ds_kpi_metrics')?.[3]?.change >= 0 ? '+' : '') + (ds('ds_kpi_metrics')?.[3]?.change || 0) + '%'"
                        }
                      }
                    }
                  ]
                }
              ]
