      "actions": {
        "act_refresh_kpi_metrics": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_kpi_metrics"
          }
        },
        "act_refresh_sales": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_sales_by_month"
          }
        },
        "act_refresh_products": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_top_products"
          }
        },
        "act_refresh_orders": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_recent_orders"
          }
        },
        "act_refresh_activity": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_user_activity"
          }
        },
        "act_refresh_all": {
          "type": "custom_script",
          "config": {
            "code": "refreshDataSource('ds_kpi_metrics'); refreshDataSource('ds_sales_by_month'); refreshDataSource('ds_top_products'); refreshDataSource('ds_recent_orders'); refreshDataSource('ds_user_activity');"
          }
        }
      },
      "state": {
        "selected_time_range": "last_30_days",
        "selected_category": "all",
        "dashboard_view": "overview"
      },
      "scripts": {
        "formatCurrency": "function formatCurrency(value) { return '$' + value.toLocaleString(); }",
        "calculateGrowth": "function calculateGrowth(current, previous) { return ((current - previous) / previous * 100).toFixed(1) + '%'; }",
        "getStatusColor": "function getStatusColor(status) { const colors = { 'Completed': 'green', 'Processing': 'blue', 'Pending': 'orange' }; return colors[status] || 'gray'; }"
      }
    },
    "pages": {
      "page_dashboard": {
        "name": "Dashboard",
        "route": "/",
        "isDefault": true,
        "root": {
          "type": "Container",
          "props": {
            "maxWidth": "xl",
            "sx": {
              "py": 3
            }
          },
          "children": [
            {
              "type": "Typography",
              "props": {
                "variant": "h4",
                "children": "Analytics Dashboard",
                "sx": {
                  "mb": 3
                }
              }
            },
            {
              "type": "Grid",
              "props": {
                "container": true,
                "spacing": 3
              },
              "children": [
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_revenue",
                      "type": "StatCard",
                      "props": {
                        "title": "Total Revenue",
                        "value": "—",
                        "subtitle": "This month",
                        "color": "#1976d2"
                      },
                      "computed": {
                        "value": {
                          "code": "const data = ds('ds_sales_by_month'); if (!data || data.length === 0) return '—'; const total = data.reduce((sum, item) => sum + item.sales, 0); return '$' + total.toLocaleString();"
                        },
                        "subtitle": {
                          "code": "const data = ds('ds_sales_by_month'); return data ? data.length + ' months tracked' : 'Loading...'"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_users",
                      "type": "StatCard",
                      "props": {
                        "title": "Active Users",
                        "value": "—",
                        "subtitle": "Currently online",
                        "color": "#2e7d32"
                      },
                      "computed": {
                        "value": {
                          "code": "const data = ds('ds_user_activity'); if (!data || data.length === 0) return '—'; const total = data.reduce((sum, item) => sum + item.active_users, 0); return total.toLocaleString();"
                        },
                        "subtitle": {
                          "code": "const data = ds('ds_user_activity'); if (!data || data.length === 0) return 'Loading...'; const latest = data[data.length - 1]; return latest ? latest.day + ': ' + latest.active_users + ' active' : 'Currently online'"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_orders",
                      "type": "StatCard",
                      "props": {
                        "title": "Total Orders",
                        "value": "—",
                        "subtitle": "This week",
                        "color": "#ed6c02"
                      },
                      "computed": {
                        "value": {
                          "code": "const data = ds('ds_recent_orders'); return data ? data.length : '—';"
                        },
                        "subtitle": {
                          "code": "const data = ds('ds_recent_orders'); if (!data) return 'Loading...'; const completed = data.filter(o => o.status === 'Completed').length; return completed + ' completed this week'"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_conversion",
                      "type": "StatCard",
                      "props": {
                        "title": "Conversion Rate",
                        "value": "—",
                        "subtitle": "Avg this month",
                        "color": "#9c27b0"
                      },
                      "computed": {
                        "value": {
                          "code": "const activity = ds('ds_user_activity'); const orders = ds('ds_recent_orders'); if (!activity || !orders) return '—'; const totalUsers = activity.reduce((sum, item) => sum + item.active_users, 0); const rate = (orders.length / totalUsers * 100).toFixed(2); return rate + '%';"
                        },
                        "subtitle": {
                          "code": "'Avg this month'"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Grid",
              "props": {
                "container": true,
                "spacing": 3,
                "sx": {
                  "mt": 1
                }
              },
              "children": [
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 8
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Revenue Trend",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "chart_revenue",
                          "type": "Chart",
                          "props": {
                            "chartType": "area",
                            "xKey": "month",
                            "yKeys": [
                              "sales"
                            ],
                            "colors": [
                              "#1976d2",
                              "#42a5f5"
                            ],
                            "height": 300
                          },
                          "bindings": {
                            "data": {
                              "source": "ds_sales_by_month"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 4
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Sales by Category",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "chart_categories",
                          "type": "Chart",
                          "props": {
                            "chartType": "pie",
                            "xKey": "category",
                            "yKeys": [
                              "revenue"
                            ],
                            "colors": [
                              "#1976d2",
                              "#2e7d32",
                              "#ed6c02",
                              "#9c27b0",
                              "#d32f2f"
                            ],
                            "height": 300
                          },
                          "bindings": {
                            "data": {
                              "source": "ds_top_products"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Grid",
              "props": {
                "container": true,
                "spacing": 3,
                "sx": {
                  "mt": 1
                }
              },
              "children": [
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 6
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Monthly Performance",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "chart_performance",
                          "type": "Chart",
                          "props": {
                            "chartType": "bar",
                            "xKey": "month",
                            "yKeys": [
                              "sales",
                              "orders"
                            ],
                            "colors": [
                              "#1976d2",
                              "#2e7d32"
                            ],
                            "height": 280
                          },
                          "bindings": {
                            "data": {
                              "source": "ds_sales_by_month"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 6
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "User Growth",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "chart_users",
                          "type": "Chart",
                          "props": {
                            "chartType": "line",
                            "xKey": "day",
                            "yKeys": [
                              "active_users",
                              "new_signups"
                            ],
                            "colors": [
                              "#9c27b0",
                              "#e91e63"
                            ],
                            "height": 280
                          },
                          "bindings": {
                            "data": {
                              "source": "ds_user_activity"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "Paper",
              "props": {
                "sx": {
                  "p": 2,
                  "mt": 3
                }
              },
              "children": [
                {
                  "type": "Stack",
                  "props": {
                    "direction": "row",
                    "justifyContent": "space-between",
                    "alignItems": "center",
                    "sx": {
                      "mb": 2
                    }
                  },
                  "children": [
                    {
                      "type": "Typography",
                      "props": {
                        "variant": "h6",
                        "children": "Recent Transactions"
                      }
                    },
                    {
                      "ref": "btn_refresh",
                      "type": "Button",
                      "props": {
                        "variant": "outlined",
                        "size": "small",
                        "children": "Refresh Data"
                      },
                      "events": {
                        "onClick": "act_refresh_all"
                      }
                    }
                  ]
                },
                {
                  "ref": "grid_transactions",
                  "type": "DataGrid",
                  "props": {
                    "pageSize": 10
                  },
                  "columns": [
                    {
                      "field": "order_id",
                      "headerName": "ID",
                      "flex": 0.5
                    },
                    {
                      "field": "customer",
                      "headerName": "Customer",
                      "flex": 1
                    },
                    {
                      "field": "amount",
                      "headerName": "Amount",
                      "flex": 0.7
                    },
                    {
                      "field": "status",
                      "headerName": "Status",
                      "flex": 0.7
                    },
                    {
                      "field": "date",
                      "headerName": "Date",
                      "flex": 0.8
                    }
                  ],
                  "bindings": {
                    "data": {
                      "source": "ds_recent_orders"
                    }
                  }
                }
              ]
            },
            {
              "type": "Grid",
              "props": {
                "container": true,
                "spacing": 3,
                "sx": {
                  "mt": 1
                }
              },
              "children": [
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 6
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Top Products",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "list_products",
                          "type": "List",
                          "props": {},
                          "bindings": {
                            "data": {
                              "source": "ds_top_products"
                            }
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 6
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Recent Activity",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "timeline_activity",
                          "type": "Timeline",
                          "props": {},
                          "bindings": {
                            "data": {
                              "source": "ds_recent_orders"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
