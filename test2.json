                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_orders",
                      "type": "StatCard",
                      "props": {
                        "title": "Total Orders",
                        "value": "—",
                        "subtitle": "This week",
                        "color": "#ed6c02"
                      },
                      "computed": {
                        "value": {
                          "code": "(ds('ds_kpi_metrics')?.[1]?.value || 0).toLocaleString()"
                        },
                        "change": {
                          "code": "ds('ds_kpi_metrics')?.[1]?.change || 0"
                        },
                        "changeLabel": {
                          "code": "(ds('ds_kpi_metrics')?.[1]?.change >= 0 ? '+' : '') + (ds('ds_kpi_metrics')?.[1]?.change || 0) + '%'"
                        }
                      }
                    }
                  ]
