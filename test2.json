                {
                  "type": "Grid",
                  "props": {
                    "xs": 12,
                    "md": 6
                  },
                  "children": [
                    {
                      "type": "Paper",
                      "props": {
                        "sx": {
                          "p": 2
                        }
                      },
                      "children": [
                        {
                          "type": "Typography",
                          "props": {
                            "variant": "h6",
                            "children": "Top Customers",
                            "sx": {
                              "mb": 2
                            }
                          }
                        },
                        {
                          "ref": "grid_customers",
                          "type": "DataGrid",
                          "props": {
                            "pageSize": 5
                          },
                          "columns": [
                            {
                              "field": "product",
                              "headerName": "Product",
                              "flex": 1.5
                            },
                            {
                              "field": "category",
                              "headerName": "Category",
                              "flex": 1
